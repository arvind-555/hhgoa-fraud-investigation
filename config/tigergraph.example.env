# Copy to ../.env (repo root, git-ignored) and fill in. NEVER commit the filled-in file.
# Variable names are the ones read by tigergraph-mcp 1.0.x (see docs/tigergraph_environment.md).
TG_HOST=https://<workspace>.i.tgcloud.io
TG_TGCLOUD=true
TG_SSL_PORT=443
# Preferred: token from a secret created in the Savanna Admin Portal (User Management)
TG_API_TOKEN=
# Fallback if no token
TG_USERNAME=
TG_PASSWORD=
# Our NEW graph only. Never the existing "Transaction Fraud" graph.
TG_GRAPHNAME=
# Optional: where the analysis scripts find the CSVs
HHG_DATA_DIR=
