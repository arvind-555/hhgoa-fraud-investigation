# LLM provider configuration (copy the names you need into the git-ignored .env; never commit values)
# HHG_LLM_PROVIDER=openrouter            # openrouter | anthropic  (default: openrouter if OPENROUTER_API_KEY is set, else anthropic if ANTHROPIC_API_KEY is set)
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# HHG_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free   # OpenRouter: the id MUST end with :free (paid models are refused)
# HHG_LLM_TIMEOUT_S=90
# OPENROUTER_HTTP_REFERER=
# OPENROUTER_APP_TITLE=
# ANTHROPIC_API_KEY=
